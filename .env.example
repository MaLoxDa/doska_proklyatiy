# Имена переменных окружения без значений.
# Реальные значения хранятся в .env в корне проекта (в репозиторий не попадает).

# --- Этап сборки фронтенда (Vite/Next: попадают в код и видны в браузере) ---
NEXT_PUBLIC_SITE_URL=https://doska.localhost
NEXT_PUBLIC_API_URL=/api

# --- Этап запуска (читает сервер, пользователю не видны) ---
APP_ENV=production
APP_PORT=8000

# --- Supabase: URL проекта и публикуемый ключ (не секрет, уходит в браузер) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Служебное для docker compose ---
TAG=local
